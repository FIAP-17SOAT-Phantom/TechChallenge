{
  "Jwt": {
    "Issuer": "OficinaMecanica.API",
    "Audience": "OficinaMecanica.Client",
    "ExpirationMinutes": 60
  },
  "Webhook": {
    "ToleranceSeconds": 300
  },
  "Email": {
    "Provider": "Log",
    "From": "Oficina Mecanica <nao-responda@exemplo.com>"
  },
  "Outbox": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "LockSeconds": 120
  },
  "Database": {
    "MigrateOnly": false,
    "ApplyMigrationsOnStartup": true
  },
  "Authentication": {
    "SeedOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
